SERVERSPACE_BASE_URL=
SERVERSPACE_API_KEY=
VK_TOKEN=
VK_GROUP_ID=
DAILY_BUDGET_RUB=100

# Картинки к постам
# Провайдер генерации: gptunnel | pollinations | template
IMAGE_PROVIDER=gptunnel
# ID моделей gptunnel через запятую (точные ID — в панели: GET /v1/models)
IMAGE_MODELS=gpt-image-1.5,gpt-image-1,gpt-image-2,gpt-image-1-mini
# Ориентировочная цена одной генерации (₽) — идёт в дневной бюджет
IMAGE_PRICE_RUB=2
# Размер изображения
IMAGE_SIZE=1080x1080
# Прикреплять ли картинку к посту (true/false)
ATTACH_IMAGES=true
